# Run npm run cli -- init to generate a private local .env and config.json.
API_TOKEN=GENERATE_WITH_CLI_INIT
API_BASE_URL=http://127.0.0.1:8080
CONFIG_PATH=config.json
DATA_DIR=data
HOST=127.0.0.1
PORT=8080

# OpenAI-compatible Chat Completions provider. Pick a model with good Hebrew/Russian support.
# No model is assumed; fill in your provider's exact model identifier.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_JSON_MODE=true

# Enable after configuring; pair with npm run cli -- pair.
WHATSAPP_ENABLED=false

# A dedicated bot, with both parents' numeric USER IDs and permitted CHAT IDs.
# Use each parent's private chat ID, or one private family group ID (usually negative).
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_IDS=
TELEGRAM_CHAT_IDS=
